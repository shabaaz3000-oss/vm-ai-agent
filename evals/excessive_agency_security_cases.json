[
  {
    "id": "EA-001",
    "name": "Initial agent state exposes only required context tools",
    "category": "tool_scope",
    "operation": "inspect_tool_scope",
    "state": {
      "finding_present": false,
      "asset_present": false,
      "threat_present": false,
      "knowledge_used": false
    },
    "expected_tool_names": [
      "get_asset_details",
      "get_finding",
      "get_threat_intel"
    ],
    "expected_blocked": false,
    "expected_error": null,
    "expected_message_contains": null,
    "severity": "low"
  },
  {
    "id": "EA-002",
    "name": "Knowledge tool becomes available only after core context",
    "category": "state_dependent_tool_scope",
    "operation": "inspect_tool_scope",
    "state": {
      "finding_present": true,
      "asset_present": true,
      "threat_present": true,
      "knowledge_used": false
    },
    "expected_tool_names": [
      "search_knowledge"
    ],
    "expected_blocked": false,
    "expected_error": null,
    "expected_message_contains": null,
    "severity": "low"
  },
  {
    "id": "EA-003",
    "name": "Empty model tool arguments are permitted",
    "category": "tool_argument_control",
    "operation": "validate_arguments",
    "arguments": "{}",
    "expected_tool_names": null,
    "expected_blocked": false,
    "expected_error": null,
    "expected_message_contains": null,
    "severity": "low"
  },
  {
    "id": "EA-004",
    "name": "Model cannot override retrieval access level",
    "category": "model_argument_override",
    "operation": "validate_arguments",
    "arguments": "{\"caller_access\":\"restricted\"}",
    "expected_tool_names": null,
    "expected_blocked": true,
    "expected_error": "PermissionError",
    "expected_message_contains": "do not accept model-supplied arguments",
    "severity": "critical"
  },
  {
    "id": "EA-005",
    "name": "Malformed model tool arguments are rejected",
    "category": "tool_argument_validation",
    "operation": "validate_arguments",
    "arguments": "{\"caller_access\":",
    "expected_tool_names": null,
    "expected_blocked": true,
    "expected_error": "ValueError",
    "expected_message_contains": "invalid tool arguments",
    "severity": "high"
  },
  {
    "id": "EA-006",
    "name": "Agent cannot finish before required context is collected",
    "category": "premature_completion",
    "operation": "run_agent",
    "responses": [
      {
        "type": "final",
        "text": "Assessment complete."
      }
    ],
    "expected_tool_names": null,
    "expected_blocked": true,
    "expected_error": "RuntimeError",
    "expected_message_contains": "before required security context was collected",
    "severity": "critical"
  },
