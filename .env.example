# =================================================
# VM AI AGENT - EXAMPLE ENVIRONMENT CONFIGURATION
# =================================================
#
# Copy the values you need into a local .env file.
#
# NEVER place real credentials in this example file.
# NEVER commit your real .env file.
#
# The credential-free portfolio demo:
#
#     python vm_agent.py demo
#
# does not require any of these credentials.


# -------------------------------------------------
# OPENAI
# -------------------------------------------------
#
# Required only when using the real OpenAI-backed
# advisory analyzer.
#
# The credential-free portfolio demo does not use
# OpenAI.

OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional.
# Defaults to gpt-5.6 in app/ai_analyzer.py.

OPENAI_MODEL=gpt-5.6


# -------------------------------------------------
# VM AI API AUTHENTICATION
# -------------------------------------------------
#
# Development/demo bearer tokens used by the
# FastAPI authentication layer.
#
# Use separate, high-entropy values.
# Do not reuse passwords or production credentials.

VM_AI_ANALYST_TOKEN=replace-with-random-analyst-token

VM_AI_APPROVER_TOKEN=replace-with-random-approver-token


# -------------------------------------------------
# WORKFLOW DATABASE
# -------------------------------------------------
#
# Optional.
# Defaults to data/workflows.db.

VM_AI_DB_PATH=data/workflows.db


# -------------------------------------------------
# TENABLE
# -------------------------------------------------
#
# Required only for authorized live Tenable API
# connectivity.
#
# The credential-free portfolio demo and file-based
# Tenable CSV workflow do not require these keys.

TENABLE_ACCESS_KEY=replace-with-your-tenable-access-key

TENABLE_SECRET_KEY=replace-with-your-tenable-secret-key


# Optional Tenable API settings.

TENABLE_BASE_URL=https://cloud.tenable.com

TENABLE_TIMEOUT_SECONDS=30

TENABLE_POLL_INTERVAL_SECONDS=1

TENABLE_MAX_POLL_ATTEMPTS=60

TENABLE_VULNERABILITY_NUM_ASSETS=500

TENABLE_ASSET_CHUNK_SIZE=5000